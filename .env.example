APP_ORIGIN=http://localhost:3000
PORT=3000
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Activar solo tras probar sandbox y confirmar tarifas / stock
LIVE_PAYMENTS_CONFIRMED=no
# En hosting: ruta de volumen persistente, por ejemplo /data
DATA_DIR=./data

# Panel /admin.html — contraseña privada de mínimo 16 caracteres
ADMIN_PASSWORD=
# Avisos de pago por correo (opcionales, requieren dominio verificado en Resend)
RESEND_API_KEY=
MAIL_FROM=
STORE_NOTIFICATION_EMAIL=
# Habilitar solo si desea correos de pruebas sandbox
MAIL_ALLOW_SANDBOX=no
